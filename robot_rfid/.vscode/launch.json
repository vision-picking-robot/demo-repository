{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RFID: UID 확인",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/rfid_scanner.py",
      "args": [
        "--read-only",
        "--timeout",
        "30"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "RFID: API 서버",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api_server:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--workers",
        "1"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    },
    {
      "name": "RFID: 시뮬레이션",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/orchestrator.py",
      "args": [
        "--quantity",
        "3"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    }
  ]
}